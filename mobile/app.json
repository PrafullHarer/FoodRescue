{
  "expo": {
    "name": "FoodRescue",
    "slug": "foodrescue-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#16A34A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodrescue.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "FoodRescue uses the camera to scan QR codes for secure physical handoff verification of surplus food donations.",
        "NSLocationWhenInUseUsageDescription": "FoodRescue uses your location to discover nearby food donations and provide delivery routes for couriers."
      }
    },
    "android": {
      "package": "com.foodrescue.app",
      "adaptiveIcon": {
        "backgroundColor": "#070907",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#84CC16",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FoodRescue requires camera access to scan delivery and pickup QR verification codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FoodRescue uses your location to show available food donations nearby."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "1e0c9205-6d23-4ded-8dbd-8b3bc93aefa2"
      }
    }
  }
}
