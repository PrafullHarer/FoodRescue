{
  "name": "food-rescue-platform",
  "version": "1.0.0",
  "description": "Full-stack web application connecting food donors, NGOs, volunteers, and admins to eliminate food waste.",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,magenta\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "npm run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "food-rescue",
    "sustainability",
    "react",
    "tailwind",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "FoodRescue Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
